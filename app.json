{
  "expo": {
    "name": "GetControl",
    "slug": "getcontrol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Prototyping-Process-Blog-Chapter-2-Image-24.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/Prototyping-Process-Blog-Chapter-2-Image-24.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Natively",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Prototyping-Process-Blog-Chapter-2-Image-24.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.Natively"
    },
    "web": {
      "favicon": "./assets/images/final_quest_240x240.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser"
    ],
    "scheme": "getcontrol",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "backendUrl": "https://fqcnbxxdan4f5vby5m87uv52bepmnrgh.app.specular.dev"
    }
  }
}